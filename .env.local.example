# Copy this file to .env.local and adjust values for your environment
# Next.js automatically loads variables from .env.local

# URL of your backend API (DO NOT set this to http://localhost:3000 because that's Next.js dev server)
# Examples:
# BACKEND_URL=http://localhost:4000
# BACKEND_URL=https://api.yourdomain.com
BACKEND_URL=http://localhost:4000
